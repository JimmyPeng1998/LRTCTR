.DS_Store
**/.DS_Store

# Local regression tests are maintained by the developers.
/tests/

# Local third-order quotient references retained for cross-validation.
/manifolds/TensorRingQuotient3d.m
/tools/quotient/TR_cores2quotient_point.m
/tools/quotient/TR_quotient_point2cores.m
/tools/quotient/TR_quotient_costgrad.m
/tools/quotient/TR_quotient_relative_error.m

# MEX binaries are compiled locally by install.m.
*.mex*

# Files generated by examples and paper experiments.
/examples/Result_*.mat
/examples/Result_*.png
/TR_Quotient_Exps/Results/*
!/TR_Quotient_Exps/Results/.gitkeep

# MovieLens data must be downloaded from GroupLens by each user.
/TR_Quotient_Exps/ratings.dat

# Revision-only runtime profiling files are kept local.
/TR_Quotient_Exps/Exp5*

# MATLAB editor backups and crash reports.
*.asv
*.swp
matlab_crash_dump.*
